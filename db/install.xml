<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/categoryfields/db" VERSION="2025091701" COMMENT="Defines database table for local_categoryfields.">
  <TABLES>
    <TABLE NAME="local_categoryfields_data" COMMENT="Stores extra data for course categories.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true" UNIQUE="true"/>
        <FIELD NAME="image" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" COMMENT="The itemid for the category image file."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="categoryid_uk" TYPE="unique" FIELDS="categoryid"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>